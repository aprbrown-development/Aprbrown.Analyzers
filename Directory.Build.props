<Project>

  <!--
    This repository is held to its own house ruleset. It is the reference implementation of the
    onboarding snippet in docs/consuming.md — with one difference: what a consumer receives through
    NuGet is wired by hand here, and the APB analyzers by ProjectReference + OutputItemType="Analyzer"
    in each project. The analyzer project cannot be its own analyzer, so it alone references the
    last published Aprbrown.Analyzers package instead, one release behind; Dependabot raises the pin.
    A released rule that misfires on that project's code is turned off for src/Aprbrown.Analyzers/
    alone in the local .editorconfig until the pin reaches the fix. A second difference: the
    snippet pins each package inline, while every version here, that pin included, comes from
    Directory.Packages.props.

    tests/Fixture.Consumer deliberately opts out of this file and of Directory.Packages.props — see
    the empty files of the same names in that directory for why.
  -->

  <!--
    Import the packed props file itself rather than restating what it does. The shipped config and
    the props file both arrive here by reference, the same physical files the packaging project
    packs, so neither can drift from what consumers get. This single line supplies the
    EnforceCodeStyleInBuild and TreatWarningsAsErrors defaults *and* the GlobalAnalyzerConfigFiles
    entry pointing at the shipped config: MSBuildThisFileDirectory inside an imported file resolves
    to that file's own directory, so the config path lands on src/Aprbrown.Analyzers.Package/build/
    as intended.

    Import position matters here exactly as it does for a consumer. Sdk.props imports
    Microsoft.Common.props — which imports this file — before Microsoft.NET.Sdk.props
    assigns TreatWarningsAsErrors=false, and that assignment is itself conditioned on the property
    being empty, so the Condition idiom in the imported file yields genuine overridable defaults.
    A .csproj <Import> would run after it and be silently overwritten.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src/Aprbrown.Analyzers.Package/build/Aprbrown.Analyzers.props" />

  <ItemGroup>
    <!--
      The packages docs/consuming.md prescribes, at the versions Directory.Packages.props pins. The
      package takes no dependency on either, so a consuming repository supplies them itself — this
      repository included.
      PrivateAssets="all" does not cover the project declaring the reference, which is why this
      belongs in Directory.Build.props rather than one project.
    -->
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Relative to the repository root, with forward slashes: it is also the path in a GitHub URL. -->
    <ConsumingGuidePath>docs/consuming.md</ConsumingGuidePath>
  </PropertyGroup>

  <!--
    The repository's web address, read from the git origin remote by the SDK's Source Link, so a
    renamed or transferred repository is picked up by the next build.
  -->
  <Target Name="ResolveRepositoryWebUrl" DependsOnTargets="InitializeSourceControlInformation">
    <Error Condition="'$(PrivateRepositoryUrl)' == '' or '$(SourceRevisionId)' == ''"
           Text="No git origin remote or commit was found, so the repository's web address is unknown. Build from a git clone with an origin remote." />
    <PropertyGroup>
      <RepositoryWebUrl>$([System.Text.RegularExpressions.Regex]::Replace('$(PrivateRepositoryUrl)', '\.git$', ''))</RepositoryWebUrl>
    </PropertyGroup>
  </Target>

</Project>
