<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.2" />

    <!-- Required pin (spec §4.1): the testing harness only floors Workspaces at 1.0.1, and
         NuGet resolves a floor to the floor. Without this explicit 4.14.0 the analyzer tests
         would run against Roslyn 1.0. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- OutputItemType="Analyzer" runs the APB rules against the test code itself (spec §7);
         ReferenceOutputAssembly stays at its default of true because the tests also need the
         analyzer types to instantiate. A project cannot be its own analyzer, so the tests are one
         of the three places the APB rules can be turned on this repository. -->
    <ProjectReference Include="..\..\src\Aprbrown.Analyzers\Aprbrown.Analyzers.csproj"
                      OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\src\Aprbrown.Analyzers.CodeFixes\Aprbrown.Analyzers.CodeFixes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the descriptor contract test holds every descriptor to: the guide its help link lands
         in (packed byte-for-byte as the package README) and the shipped config that sets its
         severity. Copied beside the test assembly so the dependency is declared here rather than
         found by walking up to the repository root. -->
    <None Include="..\..\docs\consuming.md"
          Link="Contract\consuming.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Aprbrown.Analyzers.Package\build\Aprbrown.Analyzers.globalconfig"
          Link="Contract\Aprbrown.Analyzers.globalconfig" CopyToOutputDirectory="PreserveNewest" />
    <!-- The repository's own .editorconfig, for the drift test on the severities it restates from
         the shipped config. Renamed on the way so nothing mistakes the copy for a live
         .editorconfig. -->
    <None Include="..\..\.editorconfig"
          Link="Contract\repository.editorconfig" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
