<Project>
  <!--
    Imported automatically for any project that references the Aprbrown.Analyzers package
    (NuGet build/<PackageId>.props convention). This file runs after the consumer's
    Directory.Build.props and before the SDK assigns its own TreatWarningsAsErrors default, so
    the Condition below is the whole of what makes these overridable defaults rather than a
    mandate: the consumer pre-empts them, and the Condition then finds a value and stands down.
    Do not drop it — running later than Directory.Build.props, an unconditional assignment here
    would overwrite the consumer. A .csproj <Import> would be too
    late in the other direction: the SDK's own guarded default has already set
    TreatWarningsAsErrors=false by then, so this Condition would never fire.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)'==''">true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)'==''">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The shipped config is injected through GlobalAnalyzerConfigFiles — Microsoft's documented
    extension point, which the SDK folds into EditorConfigFiles. One channel, not two.
  -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)Aprbrown.Analyzers.globalconfig" />
  </ItemGroup>
</Project>
