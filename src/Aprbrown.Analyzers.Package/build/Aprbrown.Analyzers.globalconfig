# CA1870 — Use a cached 'SearchValues' instance
dotnet_diagnostic.CA1870.severity = warning
# CA1871 — Do not pass a nullable struct to 'ArgumentNullException.ThrowIfNull'
dotnet_diagnostic.CA1871.severity = warning
# CA1872 — Prefer 'Convert.ToHexString' and 'Convert.ToHexStringLower' over call chains based on 'BitConverter.ToString'
dotnet_diagnostic.CA1872.severity = warning
# CA1874 — Use 'Regex.IsMatch'
dotnet_diagnostic.CA1874.severity = warning
# CA1875 — Use 'Regex.Count'
dotnet_diagnostic.CA1875.severity = warning

# ---------------------------------------------------------------------------------------------
# The StyleCop ordering tier — StyleCop.Analyzers 1.2.0-beta.556.
#
# Four rules, and only four. StyleCop is the one mainstream analyzer that ships member-ordering
# rules, which is the whole reason it is referenced; this is not a StyleCop adoption. Every other
# SA rule stays off under the blanket, so no category-StyleCop.CSharp.*.severity = none line is
# needed: under a blanket it is redundant, and a category line in this file would break the seal
# even when it points downwards.
#
# Severities read off the vendor's descriptors during derivation, like every other tier: all four
# default to Warning.
# ---------------------------------------------------------------------------------------------

# SA1201 — Elements should appear in the correct order
dotnet_diagnostic.SA1201.severity = warning
# SA1202 — Elements should be ordered by access
dotnet_diagnostic.SA1202.severity = warning
# SA1203 — Constants should appear before fields
dotnet_diagnostic.SA1203.severity = warning
# SA1204 — Static elements should appear before instance elements
dotnet_diagnostic.SA1204.severity = warning

# ---------------------------------------------------------------------------------------------
# The IDE, naming and style tier — the C# compiler's own code-style analyzers.
#
# Not a derivation like the three tiers above. There was no sweep to run: these are the house
# conventions themselves — `_camelCase` private fields, `PascalCase` private statics, explicit
# accessibility, no `this.`. Adoption cost was measured rather than the rule list: private-field
# `_camelCase`, private-static `PascalCase` and IDE0040 all came back at **0 violations across all
# six fleet repositories**, which is why this tier ships at `warning` with no ratchet and no
# baseline file.
#
# Every entry here must be enumerated by ID, and this tier is the one where that stops being a
# stylistic preference. Under the blanket, a naming rule whose `dotnet_diagnostic` severity is not
# set explicitly is *silently unenforced* — it neither fires nor warns that it is inactive.
# There is no vendor default to fall back on: an ID missing from this block is a convention that
# looks configured and does nothing, and nothing in a build would ever say so.
#
# Severities are given as `dotnet_diagnostic` entries, never as the `option = value:severity`
# shorthand. The shorthand sets both at once, which means a reader looking for what a rule is set
# to has two places to look and they can disagree.
#
# Three severities in this file are not `dotnet_diagnostic` entries, and none of them is an
# inconsistency — each is a key with no `dotnet_diagnostic` form at all. The blanket at the top is
# one, and has to be: a per-ID entry cannot switch off a rule that does not exist yet, which is the
# whole mechanism of the seal. The `dotnet_naming_rule.*.severity` pair below is the other two,
# because Roslyn reports every naming-rule violation under IDE1006 and that key is the only way to
# say what one of them is set to. The smoke test asserts that set exactly rather than describing
# it, so a fourth cannot appear and be read as house style.
#
# The naming rule / symbols / style triples work byte-identically in a global config. Roslyn
# matches naming rules by specificity, not declaration order, so the general private-fields rule
# never swallows the specific private-statics one, declaration order below carries no meaning, and
# these blocks may be reordered freely. tests/Fixture.Consumer/Lathe.cs measures it: a private
# static named `_created` satisfies the general rule, violates the specific one, and fires.
# ---------------------------------------------------------------------------------------------

# IDE1006 — Naming styles
#          The single ID every dotnet_naming_rule violation reports under, so the triples below
#          enforce nothing without it.
dotnet_diagnostic.IDE1006.severity = warning
# IDE0003 — Remove 'this' or 'Me' qualification
#          Enforced by the IDE only. IDE0003 is a Simplify-family rule Roslyn does not run in a
#          command-line build, EnforceCodeStyleInBuild notwithstanding — measured on SDK 10.0.110
#          in a compilation where IDE1006 and IDE0040 both fired. Kept, and kept at warning, so an
#          editor shows the squiggle and offers the fix. This is the one house convention a build
#          does not gate.
dotnet_diagnostic.IDE0003.severity = warning
# IDE0009 — Add 'this' or 'Me' qualification
#          The opposite half, and unreachable for the opposite reason: it fires in a build, but
#          only where the options below say `true`, which the house ruleset never does. Enumerated
#          so the pair is complete and a consumer flipping an option locally gets both halves.
dotnet_diagnostic.IDE0009.severity = warning
# IDE0040 — Add accessibility modifiers
dotnet_diagnostic.IDE0040.severity = warning
# CA1725 — Parameter names should match base declaration
#          `api_surface = all` extends it from public and protected overrides to every override,
#          internal types included. The package's suppressor, APBS0001, hides it on interface
#          implementations, which APB0003 reports.
dotnet_diagnostic.CA1725.severity = warning
dotnet_code_quality.CA1725.api_surface = all

# A private field carries a `_` prefix, so nothing needs `this.` to tell a field from a parameter.
# Private *statics* stay PascalCase.
dotnet_naming_rule.private_static_fields_are_pascal_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_fields_are_pascal_case.severity = warning

dotnet_naming_rule.private_fields_are_underscored.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscored.style = underscored_camel_case
dotnet_naming_rule.private_fields_are_underscored.severity = warning

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscored_camel_case.required_prefix = _
dotnet_naming_style.underscored_camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

# With the prefix in place `this.` is always redundant. Both directions are set, because the two
# IDs are the two halves of the same preference: IDE0003 removes a qualification the options below
# reject, IDE0009 adds one they would have required.
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# Every type and member spells its access out — `private` where C# would infer it, `public` on an
# interface's members included. The default reads as an omission rather than a decision; making it
# explicit means access is always something the author chose, never something the reader has to
# know the language rules to recover. `always`, not `for_non_interface_members`, so an interface
# member is held to the same rule as any other.
dotnet_style_require_accessibility_modifiers = always

# Expression bodies wherever the member is a single expression, enforced like the naming and
# accessibility rules above. At `warning`, not `suggestion`: a suggestion never reaches a build log
# while SonarQube still imports it, so a quality gate would fail on code every build had passed. At
# `warning` the build and Sonar agree, and `dotnet format style` fixes every case.
# `methods = true` rather than `when_on_single_line`, so a single statement spread over several
# lines converts too.
csharp_style_expression_bodied_constructors = when_on_single_line
# IDE0021 — Use expression body for constructors
dotnet_diagnostic.IDE0021.severity = warning

csharp_style_expression_bodied_methods = true
# IDE0022 — Use expression body for methods
dotnet_diagnostic.IDE0022.severity = warning

csharp_style_expression_bodied_properties = true
# IDE0025 — Use expression body for properties
dotnet_diagnostic.IDE0025.severity = warning

csharp_style_expression_bodied_accessors = true
# IDE0027 — Use expression body for accessors
dotnet_diagnostic.IDE0027.severity = warning

csharp_style_expression_bodied_indexers = true
# IDE0026 — Use expression body for indexers
dotnet_diagnostic.IDE0026.severity = warning

csharp_style_expression_bodied_lambdas = true
# IDE0053 — Use expression body for lambdas
dotnet_diagnostic.IDE0053.severity = warning

csharp_style_expression_bodied_local_functions = when_on_single_line
# IDE0061 — Use expression body for local functions
dotnet_diagnostic.IDE0061.severity = warning
