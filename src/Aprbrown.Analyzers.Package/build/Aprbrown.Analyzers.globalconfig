# Aprbrown.Analyzers shipped configuration — a sealed allowlist.
#
# Named Aprbrown.Analyzers.globalconfig, NOT .globalconfig: the latter is
# ancestor-auto-discovered and would collide with a consumer's own file, unsetting
# colliding keys. It is global only because of is_global = true below, and it
# deliberately does not set global_level, so a consumer's own config outranks this baseline.
#
# The house ruleset is complete: APB0001-APB0005, the Meziantou tier, the SDK CA tier, StyleCop's
# four ordering rules and the IDE, naming and style tier are all enumerated below, along with the
# performance tier — 209 rules under the blanket. Everything else is off, including rules that do
# not exist yet, and adding one from here is a deliberate act: a rule added or a severity raised is
# a minor version bump.
#
# Nothing here sets AnalysisMode or AnalysisLevel, and nothing in this package does either.
# Measured on SDK 10.0.110: neither reaches past the blanket at any value, All and latest-all
# included. Setting one would document an intent the build does not honour. The CA rules below are
# back on because they are named, like everything else in this file.
is_global = true

# The blanket: everything off, including rules that do not exist yet.
dotnet_analyzer_diagnostic.severity = none

# APB0001 — do not use primary constructors on classes or structs.
dotnet_diagnostic.APB0001.severity = warning

# APB0002 — do not give a CancellationToken parameter a default value.
dotnet_diagnostic.APB0002.severity = warning

# APB0003 — parameter names should match the implemented interface member.
dotnet_diagnostic.APB0003.severity = warning

# APB0004 — put an expression body's arrow at the end of the declaration line.
dotnet_diagnostic.APB0004.severity = warning

# APB0005 — put a comment on its own line above the code it describes.
dotnet_diagnostic.APB0005.severity = warning

# ---------------------------------------------------------------------------------------------
# The Meziantou tier — Meziantou.Analyzer 3.0.123.
#
# Derived once, then frozen. The derivation was: load the pinned analyzer assembly, instantiate
# every DiagnosticAnalyzer it exports, and read IsEnabledByDefault and DefaultSeverity off each
# supported DiagnosticDescriptor. 209 rules, 173 enabled by default, of which 103 default to a
# build-gating severity — 100 Warning and three Error (MA0037, MA0039, MA0049). Each is recorded
# below at the severity its vendor assigns, read rather than assumed. The remaining 70 enabled
# rules default to Info or Hidden, do not gate a build, and are not part of the house ruleset.
#
# Two deliberate departures from that sweep, and only two:
#   - MA0004 (ConfigureAwait) is omitted. The sole universality-test exclusion: its rationale is
#     false for a class library. An all-web repository may re-enable it in its own .editorconfig.
#   - MA0032 is added at warning although the vendor defaults it to off. It is the call-site half
#     of the cancellation rule, standing opposite APB0002's declaration half, and it stands alone:
#     MA0040 and CA2016 are enabled by default but at Info, so they do not gate a build and
#     neither tier's sweep carries them. Adding either would be a third departure from the sweep.
# 103 default-on, minus one, plus one — 103 rules.
#
# MA0220, MA0240 and MA0241, at the end of the list, are silent until a repository writes a regex
# option for MA0003, MA0048 or MA0104, or a BannedSyntaxes.txt, and then report only its own bans
# or the typos that would quietly void its configuration — 106 rules.
#
# Re-running the derivation against a newer Meziantou.Analyzer would silently admit whatever
# rules that version added, which is precisely what the seal exists to prevent. Do not regenerate
# this block. From here it is edited by hand, one deliberate line at a time — a rule added or a
# severity raised is a minor version bump.
#
# Rules that are framework-specific but inert elsewhere are on by design (MA0115-MA0119, MA0123,
# MA0124-MA0126, MA0139, MA0153 — Blazor, Microsoft.Extensions.Logging, Serilog). They are silent
# where the framework is absent and cover the day a repository adopts it; silence is harmless,
# falsity is not. MA0025 and MA0026 are likewise on, MA0025 with a documented tests/** carve-out
# in the onboarding snippet, because throwing NotImplementedException *is* the correct way to say
# something is not part of a fake's contract.
#
# The comment above each line is the vendor's own title for the rule, carried across so a hand
# edit can be read and audited without a browser.
# ---------------------------------------------------------------------------------------------

