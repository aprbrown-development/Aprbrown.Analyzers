# ---------------------------------------------------------------------------------------------
# The SDK CA tier — Microsoft.CodeAnalysis.NetAnalyzers as shipped in .NET SDK 10.0.110
# (spec §2.3 step 2).
#
# Derived once, then frozen, the same way the Meziantou tier was: load the two analyzer
# assemblies the SDK ships (Microsoft.CodeAnalysis.NetAnalyzers.dll and its C# companion),
# instantiate every DiagnosticAnalyzer they export, and read IsEnabledByDefault and
# DefaultSeverity off each supported DiagnosticDescriptor. 317 rules, 171 enabled by default, of
# which 29 default to a build-gating severity — 27 Warning and two Error (CA1856, CA2252). The
# other 142 enabled rules default to Info (89) or Hidden (53), do not gate a build, and are not
# part of the house ruleset. Each rule below is recorded at the severity the SDK assigns it,
# read rather than assumed.
#
# The SDK's own AnalysisMode=Default is the descriptor defaults minus rules released after the
# analysis level: analysislevel_10_default.globalconfig turns off exactly one rule, CA1516, which
# defaults to Info and so falls outside the gating filter regardless.
#
# 29, not the 27 spec §2.3 step 2 states. The measured 27 is the Warning-severity subset; CA1856
# and CA2252 are the two the SDK defaults to Error. Dropping them to reach 27 would flatten the
# vendor's own judgement, which §2.3 forbids in the same breath as it gives the count, and would
# leave two error-severity SDK rules a plain `dotnet build` enforces today silently off across the
# fleet. Recorded as a correction in spec §10 rather than reconciled by deletion.
#
# A contradiction check against the rest of the ruleset came back clean: all 29 are correctness
# rules — platform compatibility, marshalling, stackalloc in loops, rethrow, spans — with no
# naming or ordering opinion. The only overlaps are duplications, never conflicts: CA2200≈MA0027
# and CA2013≈MA0006-adjacent, same fix in each case.
#
# The two rules that would genuinely fight the house style stay off, and how they stay off is
# worth being exact about because ADR-0002 decision 4 rests on it:
#   - CA2007 (ConfigureAwait) is enabled-by-default *false* at Warning. Genuinely default-off,
#     and against the MA0004 exclusion, so it stays out.
#   - CA1707 (identifiers should not contain underscores) is enabled by default at *Hidden*, not
#     off as ADR-0002 decision 4 and spec §10 correction 2 both say. It is off here because the
#     blanket sets it to none and this file never names it — but a category re-enable of Naming
#     would set it to warning and it would fight the house _camelCase convention, which is the
#     demonstration those two passages were making. The conclusion stands; only the word
#     "default-off" was imprecise. See spec §10.
#
# Re-running this derivation against a newer SDK would silently admit whatever rules that version
# added, which is precisely what the seal exists to prevent (ADR-0002 decision 3). Do not
# regenerate this block. From here it is edited by hand, one deliberate line at a time, under
# ADR-0004.
#
# The comment above each line is the vendor's own title for the rule, carried across so a hand
# edit can be read and audited without a browser.
# ---------------------------------------------------------------------------------------------

# CA1416 — Validate platform compatibility
dotnet_diagnostic.CA1416.severity = warning
# CA1417 — Do not use 'OutAttribute' on string parameters for P/Invokes
dotnet_diagnostic.CA1417.severity = warning
# CA1418 — Use valid platform string
dotnet_diagnostic.CA1418.severity = warning
# CA1420 — Property, type, or attribute requires runtime marshalling
dotnet_diagnostic.CA1420.severity = warning
# CA1422 — Validate platform compatibility
dotnet_diagnostic.CA1422.severity = warning
# CA1831 — Use AsSpan or AsMemory instead of Range-based indexers when appropriate
dotnet_diagnostic.CA1831.severity = warning
# CA1856 — Incorrect usage of ConstantExpected attribute
dotnet_diagnostic.CA1856.severity = error
# CA1857 — A constant is expected for the parameter
dotnet_diagnostic.CA1857.severity = warning
# CA2013 — Do not use ReferenceEquals with value types
dotnet_diagnostic.CA2013.severity = warning
# CA2014 — Do not use stackalloc in loops
dotnet_diagnostic.CA2014.severity = warning
# CA2015 — Do not define finalizers for types derived from MemoryManager<T>
dotnet_diagnostic.CA2015.severity = warning
# CA2017 — Parameter count mismatch
dotnet_diagnostic.CA2017.severity = warning
# CA2018 — 'Buffer.BlockCopy' expects the number of bytes to be copied for the 'count' argument
dotnet_diagnostic.CA2018.severity = warning
# CA2021 — Do not call Enumerable.Cast<T> or Enumerable.OfType<T> with incompatible types
dotnet_diagnostic.CA2021.severity = warning
# CA2022 — Avoid inexact read with 'Stream.Read'
dotnet_diagnostic.CA2022.severity = warning
# CA2023 — Invalid braces in message template
dotnet_diagnostic.CA2023.severity = warning
# CA2024 — Do not use 'StreamReader.EndOfStream' in async methods
dotnet_diagnostic.CA2024.severity = warning
# CA2200 — Rethrow to preserve stack details
dotnet_diagnostic.CA2200.severity = warning
# CA2247 — Argument passed to TaskCompletionSource constructor should be TaskCreationOptions enum instead of TaskContinuationOptions enum
dotnet_diagnostic.CA2247.severity = warning
# CA2252 — This API requires opting into preview features
dotnet_diagnostic.CA2252.severity = error
# CA2255 — The 'ModuleInitializer' attribute should not be used in libraries
dotnet_diagnostic.CA2255.severity = warning
# CA2256 — All members declared in parent interfaces must have an implementation in a DynamicInterfaceCastableImplementation-attributed interface
dotnet_diagnostic.CA2256.severity = warning
# CA2257 — Members defined on an interface with the 'DynamicInterfaceCastableImplementationAttribute' should be 'static'
dotnet_diagnostic.CA2257.severity = warning
# CA2258 — Providing a 'DynamicInterfaceCastableImplementation' interface in Visual Basic is unsupported
dotnet_diagnostic.CA2258.severity = warning
# CA2259 — 'ThreadStatic' only affects static fields
dotnet_diagnostic.CA2259.severity = warning
# CA2260 — Use correct type parameter
dotnet_diagnostic.CA2260.severity = warning
# CA2261 — Do not use ConfigureAwaitOptions.SuppressThrowing with Task<TResult>
dotnet_diagnostic.CA2261.severity = warning
# CA2264 — Do not pass a non-nullable value to 'ArgumentNullException.ThrowIfNull'
dotnet_diagnostic.CA2264.severity = warning
# CA2265 — Do not compare Span<T> to 'null' or 'default'
dotnet_diagnostic.CA2265.severity = warning

# ---------------------------------------------------------------------------------------------
# The StyleCop ordering tier — StyleCop.Analyzers 1.2.0-beta.556 (spec §2.3 step 3).
#
# Four rules, and only four. StyleCop is the one mainstream analyzer that ships member-ordering
# rules, which is the whole reason it is referenced; this is not a StyleCop adoption. Every other
# SA rule stays off under the blanket, which is also why the eight
# category-StyleCop.CSharp.*.severity = none lines the source repository carried are not ported:
# under a blanket they are redundant, and a category line in this file would break the seal even
# when it points downwards.
#
# Severities read off the vendor's descriptors during derivation, like every other tier: all four
# default to Warning.
# ---------------------------------------------------------------------------------------------

# SA1201 — Elements should appear in the correct order
dotnet_diagnostic.SA1201.severity = warning
# SA1202 — Elements should be ordered by access
dotnet_diagnostic.SA1202.severity = warning
# SA1203 — Constants should appear before fields
dotnet_diagnostic.SA1203.severity = warning
# SA1204 — Static elements should appear before instance elements
dotnet_diagnostic.SA1204.severity = warning

# ---------------------------------------------------------------------------------------------
# The IDE, naming and style tier — the C# compiler's own code-style analyzers (spec §2.3 step 4).
#
# Not a derivation like the three tiers above. There was no sweep to run: these are the house
# conventions themselves — `_camelCase` private fields, `PascalCase` private statics, explicit
# accessibility, no `this.` — carried across from the source repository, which had arrived at them
# by hand. Adoption cost was measured rather than the rule list: private-field `_camelCase`,
# private-static `PascalCase` and IDE0040 all came back at **0 violations across all six fleet
# repositories**, which is why this tier ships at `warning` with no ratchet and no baseline file.
#
# Every entry here must be enumerated by ID, and this tier is the one where that stops being a
# stylistic preference. Under the blanket, a naming rule whose `dotnet_diagnostic` severity is not
# set explicitly is *silently unenforced* — it neither fires nor warns that it is inactive (#4).
# There is no vendor default to fall back on: an ID missing from this block is a convention that
# looks configured and does nothing, and nothing in a build would ever say so.
#
# Severities are given as `dotnet_diagnostic` entries, never as the `option = value:severity`
# shorthand the source repository used. The shorthand sets both at once, which means a reader
# looking for what a rule is set to has two places to look and they can disagree.
#
# Three severities in this file are not `dotnet_diagnostic` entries, and none of them is an
# inconsistency — each is a key with no `dotnet_diagnostic` form at all. The blanket at the top is
# one, and has to be: a per-ID entry cannot switch off a rule that does not exist yet, which is the
# whole mechanism of the seal. The `dotnet_naming_rule.*.severity` pair below is the other two,
# because Roslyn reports every naming-rule violation under IDE1006 and that key is the only way to
# say what one of them is set to. The smoke test asserts that set exactly rather than describing
# it, so a fourth cannot appear and be read as house style.
#
# The naming rule / symbols / style triples are ported verbatim; #2 verified they work
# byte-identically in a global config. What is *not* ported is the comment that accompanied them,
# which claimed naming rules are matched in declaration order and that the general private-fields
# rule would otherwise swallow the specific private-statics one. That is false — Roslyn orders
# them by specificity, verified twice in #2 — and the behaviour was correct for a different reason
# than the comment gave. Declaration order below therefore carries no meaning and these blocks may
# be reordered freely. tests/Fixture.Consumer/Lathe.cs measures it: a private static named
# `_created` satisfies the general rule, violates the specific one, and fires.
# ---------------------------------------------------------------------------------------------

# IDE1006 — Naming styles
#          The single ID every dotnet_naming_rule violation reports under, so the triples below
#          enforce nothing without it.
dotnet_diagnostic.IDE1006.severity = warning
# IDE0003 — Remove 'this' or 'Me' qualification
#          Enforced by the IDE only. IDE0003 is a Simplify-family rule Roslyn does not run in a
#          command-line build, EnforceCodeStyleInBuild notwithstanding — measured on SDK 10.0.110
#          in a compilation where IDE1006 and IDE0040 both fired. Kept, and kept at warning, so an
#          editor shows the squiggle and offers the fix; spec §10 correction 12 records that this
#          is the one house convention a build does not gate.
dotnet_diagnostic.IDE0003.severity = warning
# IDE0009 — Add 'this' or 'Me' qualification
#          The opposite half, and unreachable for the opposite reason: it fires in a build, but
#          only where the options below say `true`, which the house ruleset never does. Enumerated
#          so the pair is complete and a consumer flipping an option locally gets both halves.
dotnet_diagnostic.IDE0009.severity = warning
# IDE0040 — Add accessibility modifiers
dotnet_diagnostic.IDE0040.severity = warning

# A private field carries a `_` prefix, so nothing needs `this.` to tell a field from a parameter.
# Private *statics* stay PascalCase.
dotnet_naming_rule.private_static_fields_are_pascal_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_fields_are_pascal_case.severity = warning

dotnet_naming_rule.private_fields_are_underscored.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscored.style = underscored_camel_case
dotnet_naming_rule.private_fields_are_underscored.severity = warning

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscored_camel_case.required_prefix = _
dotnet_naming_style.underscored_camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

# With the prefix in place `this.` is always redundant. Both directions are set, because the two
# IDs are the two halves of the same preference: IDE0003 removes a qualification the options below
# reject, IDE0009 adds one they would have required.
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# Every type and member spells its access out — `private` where C# would infer it, `public` on an
# interface's members included. The default reads as an omission rather than a decision; making it
# explicit means access is always something the author chose, never something the reader has to
# know the language rules to recover. `always`, not `for_non_interface_members`, so an interface
# member is held to the same rule as any other.
dotnet_style_require_accessibility_modifiers = always

# Expression bodies wherever the member is a single expression — and the only rules in this file
# that do not gate. `suggestion` is the whole point of them: six repositories agree on shape
# without a disagreement failing anyone's build, which is a different bargain from the naming and
# accessibility rules above and is why the severities differ rather than the list being shorter.
csharp_style_expression_bodied_constructors = when_on_single_line
# IDE0021 — Use expression body for constructors
dotnet_diagnostic.IDE0021.severity = suggestion

csharp_style_expression_bodied_methods = true
# IDE0022 — Use expression body for methods
dotnet_diagnostic.IDE0022.severity = suggestion

csharp_style_expression_bodied_properties = true
# IDE0025 — Use expression body for properties
dotnet_diagnostic.IDE0025.severity = suggestion

csharp_style_expression_bodied_accessors = true
# IDE0027 — Use expression body for accessors
dotnet_diagnostic.IDE0027.severity = suggestion

csharp_style_expression_bodied_indexers = true
# IDE0026 — Use expression body for indexers
dotnet_diagnostic.IDE0026.severity = suggestion

csharp_style_expression_bodied_lambdas = true
# IDE0053 — Use expression body for lambdas
dotnet_diagnostic.IDE0053.severity = suggestion

csharp_style_expression_bodied_local_functions = when_on_single_line
# IDE0061 — Use expression body for local functions
dotnet_diagnostic.IDE0061.severity = suggestion
