<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- This assembly is packed by Aprbrown.Analyzers.Package, not on its own. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Roslyn analyzer authoring rules (RS*). -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Workspaces rather than CSharp alone: the APB0003 fix renames a symbol rather than
         rewriting a token, and Renamer lives in Workspaces. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Two jobs in one reference. The diagnostic IDs are shared with the analyzer, so the fixer
         names the same ID the analyzer reports; and OutputItemType="Analyzer" runs the APB rules
         against this project, so the code fix project is gated by the house ruleset like any
         other. A project cannot be its own analyzer, so this reference is how a project other than
         src/Aprbrown.Analyzers gets the APB rules; the rest of the dogfooding wiring — the shipped
         config, the local .editorconfig, the third-party pins — arrives through
         Directory.Build.props. -->
    <ProjectReference Include="..\Aprbrown.Analyzers\Aprbrown.Analyzers.csproj"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
