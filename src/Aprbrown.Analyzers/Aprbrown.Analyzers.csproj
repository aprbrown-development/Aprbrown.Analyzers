<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- This assembly is packed by Aprbrown.Analyzers.Package, not on its own. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Roslyn analyzer authoring rules (RS*), including release tracking (RS2008). -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn pinned to 4.14.0 (spec §4.1): an analyzer built against an older
         Roslyn loads in a newer host, never the reverse. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixer must name the same diagnostic ID the analyzer reports, and ADR-0004 makes that
         string public API. Reading it from the shared descriptor keeps one definition; the assembly
         surface stays closed. -->
    <InternalsVisibleTo Include="Aprbrown.Analyzers.CodeFixes" />

    <!-- A diagnostic contract is internal, shared by an analyzer and its fixer, and is tested
         directly through its own round trip rather than only through the light bulb. -->
    <InternalsVisibleTo Include="Aprbrown.Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
