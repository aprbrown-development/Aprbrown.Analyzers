<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- This assembly is packed by Aprbrown.Analyzers.Package, not on its own. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Not the published package's ID, so referencing that package below is no self-cycle (NU1108). -->
    <PackageId>Aprbrown.Analyzers.Source</PackageId>

    <!-- Roslyn analyzer authoring rules (RS*), including release tracking (RS2008). -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs the published package's APB rules against this project, which cannot be its own
         analyzer. PrivateAssets="all" keeps the package off every project that references this one, which
         already runs the current rules from source and would otherwise report each diagnostic
         twice. ExcludeAssets="build;buildTransitive" drops the package's props: Directory.Build.props
         already supplies the shipped config, and a second copy would unset every shared key
         (MultipleGlobalAnalyzerKeys). -->
    <PackageReference Include="Aprbrown.Analyzers"
                      PrivateAssets="all" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixer must name the same diagnostic ID the analyzer reports, and that string is public
         API. Reading it from the shared descriptor keeps one definition; the assembly
         surface stays closed. -->
    <InternalsVisibleTo Include="Aprbrown.Analyzers.CodeFixes" />

    <!-- A diagnostic contract is internal, shared by an analyzer and its fixer, and is tested
         directly through its own round trip rather than only through the light bulb. -->
    <InternalsVisibleTo Include="Aprbrown.Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!--
    ConsumingGuide.Url, the base of every help link: the consuming guide at the commit being built,
    so a shipped link keeps showing the guide that described its version after the guide moves or
    changes.
  -->
  <Target Name="GenerateConsumingGuideUrl" BeforeTargets="CoreCompile" DependsOnTargets="ResolveRepositoryWebUrl">
    <PropertyGroup>
      <ConsumingGuideUrlFile>$(IntermediateOutputPath)ConsumingGuide.g.cs</ConsumingGuideUrlFile>
      <ConsumingGuideUrl>$(RepositoryWebUrl)/blob/$(SourceRevisionId)/$(ConsumingGuidePath)</ConsumingGuideUrl>
    </PropertyGroup>
    <WriteLinesToFile File="$(ConsumingGuideUrlFile)"
                      Lines="// &lt;auto-generated/&gt;;namespace Aprbrown.Analyzers%3B;internal static class ConsumingGuide { public const string Url = &quot;$(ConsumingGuideUrl)&quot;%3B }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(ConsumingGuideUrlFile)" />
      <FileWrites Include="$(ConsumingGuideUrlFile)" />
    </ItemGroup>
  </Target>

</Project>
