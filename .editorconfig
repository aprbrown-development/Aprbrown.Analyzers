# This repository's local deviations from the shipped configuration it consumes.
#
# It is the reference implementation of the onboarding snippet: every entry below is a deviation
# taken through the mechanism every consumer gets — a local .editorconfig, which outranks a global
# AnalyzerConfig outright. Nothing here changes src/Aprbrown.Analyzers.Package/build/
# Aprbrown.Analyzers.globalconfig; a house rule that trips this repository's own code is fixed here,
# never there.

root = true

[*.cs]

# --- Restoring the analyzer-authoring safety net -----------------------------------------------
#
# Microsoft.CodeAnalysis.Analyzers ships the RS-series that keeps analyzer authors honest — RS1001
# through the RS2000-series that keeps AnalyzerReleases.Shipped.md / .Unshipped.md truthful,
# RS2008 included. The shipped config's blanket switches all of it off, which in the one repository
# in the fleet where it matters would leave release tracking silently unenforced.
#
# Re-enabled by *category*, one line each, so RS rules added by future package versions are covered
# without editing this file. Category-level re-enabling is correct here and does not unseal the
# sealed allowlist: the seal governs what the package promises consumers, and this is a local
# config, where a repository loosening rules for itself is the deviation mechanism working.
dotnet_analyzer_diagnostic.category-MicrosoftCodeAnalysisCorrectness.severity = warning
dotnet_analyzer_diagnostic.category-MicrosoftCodeAnalysisDesign.severity = warning
dotnet_analyzer_diagnostic.category-MicrosoftCodeAnalysisReleaseTracking.severity = warning
dotnet_analyzer_diagnostic.category-MicrosoftCodeAnalysisPerformance.severity = warning

# --- Restating the expression-bodied severities for dotnet format ------------------------------
#
# Not a deviation: these are the shipped config's own values, and the build already enforces them
# from there. `dotnet format` does not. It acts only on a severity it finds in an .editorconfig and
# ignores one delivered through GlobalAnalyzerConfigFiles, so without these lines
# `dotnet format style --diagnostics IDE0022` reports nothing to fix while the build fails on it.
# The options themselves stay in the shipped config; only the severity has to be here. This file
# outranks the global config, so a value changed there and not here would be silently overridden in
# this repository — EditorConfigDriftTests fails the build when any IDE severity here disagrees.
dotnet_diagnostic.IDE0021.severity = warning
dotnet_diagnostic.IDE0022.severity = warning
dotnet_diagnostic.IDE0025.severity = warning
dotnet_diagnostic.IDE0026.severity = warning
dotnet_diagnostic.IDE0027.severity = warning
dotnet_diagnostic.IDE0053.severity = warning
dotnet_diagnostic.IDE0061.severity = warning

# --- Deviations this repository takes -----------------------------------------------------------

[tests/**.cs]
# The carve-out docs/consuming.md marks "not optional" for every consumer, applied to the
# repository that prescribes it. Test doubles hold values rather than injected dependencies, which
# is the one shape APB0001 should not object to — and the tests project is gated by the APB rules
# like any other project here, so without this the first `private sealed class StubX(Y y) : IY`
# would fail the build.
dotnet_diagnostic.APB0001.severity = none

# The other half of that same snippet. Throwing NotImplementedException *is* the correct way for a
# test double to say a member is not part of its contract, so the rule is right everywhere except
# here. Written even though no test currently throws one: this repository is the reference
# implementation of the onboarding snippet, and a consumer copying it should find both halves.
dotnet_diagnostic.MA0025.severity = none

# SA0001 fires when a project does not generate an XML documentation file, and test projects have no
# reason to. It survives the shipped config's blanket because it is reported with no location, and a
# bulk `dotnet_analyzer_diagnostic.severity` entry does not reach a diagnostic that has no syntax
# tree to resolve options against — an explicit ID does, which is what this is. Every consumer with
# a test project meets the same thing on onboarding, so the onboarding snippet carries it too.
dotnet_diagnostic.SA0001.severity = none

# The analyzer-authoring safety net restored above guards analyzers that ship. A test project has
# none: the stub analyzers it declares stand in for other vendors' rules, reuse their reserved IDs,
# and are never loaded by a compiler, so these five have nothing to protect here.
dotnet_diagnostic.RS1029.severity = none
dotnet_diagnostic.RS1036.severity = none
dotnet_diagnostic.RS1038.severity = none
dotnet_diagnostic.RS1041.severity = none
dotnet_diagnostic.RS2008.severity = none
